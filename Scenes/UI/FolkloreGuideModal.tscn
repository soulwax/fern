theme_override_font_sizes/font_size = 12
text = "Der UV-Lichtkegel entlarvt die wahre Horngestalt des Geistes.
[R] krümmt die Hände schützend, um die Blüte zu schonen.
An Wasserkrügen auf Werkbänken regenerierst du die Leuchtkraft."
